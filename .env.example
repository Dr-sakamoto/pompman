# Supabase プロジェクトの設定 → API からコピー
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# マジックリンクの戻り先。ローカルは http://localhost:3000、
# 本番は Vercel のドメインを入れる（Supabase の Auth > URL Configuration にも登録すること）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API キー（必須）。AI が大喜利の回答を10個出すのに使う。
# https://console.anthropic.com で発行し、Vercel の環境変数にも同じ名前で入れる。
ANTHROPIC_API_KEY=
