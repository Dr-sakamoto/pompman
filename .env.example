# Supabase プロジェクトの設定 → API からコピー
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# マジックリンクの戻り先。ローカルは http://localhost:3000、
# 本番は Vercel のドメインを入れる（Supabase の Auth > URL Configuration にも登録すること）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Push 通知（任意）。未設定なら通知機能はまるごと無効になるだけで、他の機能には影響しない。
# `npx web-push generate-vapid-keys` で1組作って、公開鍵と秘密鍵をそれぞれ入れる。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 通知の送信元として push サービスに伝える連絡先。mailto: か https: の URL。
VAPID_SUBJECT=mailto:admin@example.com
